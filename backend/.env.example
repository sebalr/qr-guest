DATABASE_URL=postgresql://tiqra_app:change_me_db_password@localhost:5433/tiqra
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tiqra_shadow
JWT_SECRET=change_me_jwt_secret
QR_SECRET=change_me_qr_secret
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
# Google reCAPTCHA Enterprise — all three must be set to enable server-side verification.
# Leave empty to skip verification in development.
# See: https://cloud.google.com/recaptcha/docs/create-assessment
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SITE_KEY=

# Mercado Pago Checkout Pro (server-only). Empty credentials disable payments.
MP_ACCESS_TOKEN=
MP_MERCHANT_ID=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://api.example.com/billing/webhooks/mercadopago
MP_SANDBOX=true
PAYMENT_RECONCILE_MS=60000
# Optional integration-test database; use a disposable DB whose name contains tiqra_test.
TEST_DATABASE_URL=
